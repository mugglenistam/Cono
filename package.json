{
  "name": "vlc-redesign",
  "productName": "VLC Redesign",
  "version": "1.0.0",
  "description": "A modern redesign of VLC media player (Windows)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.example.vlcredesign",
    "productName": "VLC Redesign",
    "files": ["main.js", "preload.js", "src/**/*", "package.json"],
    "fileAssociations": [
      { "ext": ["mp4","mkv","webm","mov","m4v","mp3","flac","wav","ogg","m4a","opus"], "name": "Media file", "role": "Viewer" }
    ],
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "dependencies": {
    "music-metadata": "^11.16.1"
  }
}
